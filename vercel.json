{
  "outputDirectory": "public",
  "buildCommand": "python3 --version",
  "installCommand": "python3 -m pip install flask gunicorn",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
